# ---------------------------------------------------------------
# apps/api — ces variables ne vivent QUE côté serveur.
# Ne jamais exposer ANTHROPIC_API_KEY dans apps/mobile.
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Modèles (modifiables sans changer le code)
COACH_MODEL=claude-sonnet-5-5
RECAP_MODEL=claude-haiku-5-5
# Secret de signature des jetons device (chaîne aléatoire longue)
DEVICE_TOKEN_SECRET=change-me
PORT=8787
LOG_LEVEL=info
# Quotas par utilisateur et par jour
COACH_DAILY_LIMIT=20
RECAP_DAILY_LIMIT=3
RECAP_TIMEOUT_MS=3500

# ---------------------------------------------------------------
# apps/mobile — seules les variables EXPO_PUBLIC_* sont embarquées.
# Elles sont publiques : n'y mettez jamais de secret.
# ---------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8787
